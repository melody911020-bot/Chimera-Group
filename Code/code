# 1. Install packages if needed
install.packages(c("readxl", "tidyverse", "lubridate", "ggplot2", "corrplot"))

# 2. Load packages
library(readxl)
library(tidyverse)
library(lubridate)
library(corrplot)

# 3. Read Excel file
data <- read_excel("All_data(Tourism,Rainfall,Temperature)(1996-2025).xlsx")

# 4. Check data
str(data)
summary(data)
colSums(is.na(data))

# 5. Clean data
data <- data %>%
  mutate(
    Year = as.numeric(Year),
    Month = as.numeric(Month),
    Date = as.Date(paste(Year, Month, "01", sep = "-")),
    Temp_C = as.numeric(Temp_C),
    Rainfall_millimetres = as.numeric(Rainfall_millimetres),
    Tourists = as.numeric(Tourists)
  )

# 6. Time series plot: tourists
ggplot(data, aes(x = Date, y = Tourists)) +
  geom_line() +
  labs(
    title = "Monthly Tourist Numbers in Brisbane Airport (1996–2025)",
    x = "Year",
    y = "Tourists"
  )

# 7. Time series plot: rainfall
ggplot(data, aes(x = Date, y = Rainfall_millimetres)) +
  geom_line() +
  labs(
    title = "Monthly Rainfall in Brisbane (1996–2025)",
    x = "Year",
    y = "Rainfall (mm)"
  )

# 8. Scatter plot: rainfall vs tourists
ggplot(data, aes(x = Rainfall_millimetres, y = Tourists)) +
  geom_point() +
  geom_smooth(method = "lm", se = TRUE) +
  labs(
    title = "Relationship between Rainfall and Tourist Numbers",
    x = "Rainfall (mm)",
    y = "Tourists"
  )

# 9. Scatter plot: temperature vs tourists
ggplot(data, aes(x = Temp_C, y = Tourists)) +
  geom_point() +
  geom_smooth(method = "lm", se = TRUE) +
  labs(
    title = "Relationship between Temperature and Tourist Numbers",
    x = "Temperature (°C)",
    y = "Tourists"
  )

# 10. Correlation matrix
cor_data <- data %>%
  select(Temp_C, Rainfall_millimetres, Tourists)

cor_matrix <- cor(cor_data, use = "complete.obs")
print(cor_matrix)

corrplot(cor_matrix, method = "number")

# 11. Simple regression: rainfall only
model1 <- lm(Tourists ~ Rainfall_millimetres, data = data)
summary(model1)

# 12. Multiple regression: rainfall + temperature
model2 <- lm(Tourists ~ Rainfall_millimetres + Temp_C, data = data)
summary(model2)

# 13. Add month as seasonal control
data$Month_factor <- as.factor(data$Month)

model3 <- lm(Tourists ~ Rainfall_millimetres + Temp_C + Month_factor, data = data)
summary(model3)

# 14. Compare models
anova(model1, model2, model3)

# =========================================================
# Assumption Checking for Model 3
# Model 3: Tourists ~ Rainfall_millimetres + Temp_C + Month_factor
# =========================================================

# Load packages
library(ggplot2)
library(car)

# ---------------------------------------------------------
# 1. Residuals versus fitted values
# ---------------------------------------------------------

ggplot(data, aes(x = fitted(model3), y = residuals(model3))) +
  geom_point() +
  geom_abline(slope = 0, intercept = 0, color = "red") +
  labs(
    x = "Fitted values",
    y = "Residuals",
    title = "Residuals versus Fitted Values"
  ) +
  theme_bw()


# ---------------------------------------------------------
# 2. Residuals versus Rainfall
# ---------------------------------------------------------

ggplot(data, aes(x = Rainfall_millimetres, y = residuals(model3))) +
  geom_point() +
  geom_abline(slope = 0, intercept = 0, color = "red") +
  labs(
    x = "Rainfall (mm)",
    y = "Residuals",
    title = "Residuals versus Rainfall"
  ) +
  theme_bw()


# ---------------------------------------------------------
# 3. Residuals versus Temperature
# ---------------------------------------------------------

ggplot(data, aes(x = Temp_C, y = residuals(model3))) +
  geom_point() +
  geom_abline(slope = 0, intercept = 0, color = "red") +
  labs(
    x = "Temperature (°C)",
    y = "Residuals",
    title = "Residuals versus Temperature"
  ) +
  theme_bw()


# ---------------------------------------------------------
# 4. Residuals versus Month / Seasonality
# ---------------------------------------------------------

ggplot(data, aes(x = Month_factor, y = residuals(model3))) +
  geom_boxplot() +
  geom_hline(yintercept = 0, color = "red") +
  labs(
    x = "Month",
    y = "Residuals",
    title = "Residuals versus Month"
  ) +
  theme_bw()


# ---------------------------------------------------------
# 5. Normal QQ plot of residuals
# ---------------------------------------------------------

ggplot(mapping = aes(sample = residuals(model3))) +
  stat_qq(distribution = stats::qnorm) +
  stat_qq_line(distribution = stats::qnorm, color = "red") +
  labs(
    x = "Theoretical",
    y = "Sample",
    title = "Normal QQ Plot of Residuals"
  ) +
  theme_bw()


# ---------------------------------------------------------
# 6. Variance Inflation Factor (VIF)
# ---------------------------------------------------------

vif(model3)
